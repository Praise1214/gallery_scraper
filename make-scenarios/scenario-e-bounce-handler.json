{
  "name": "Art Gallery Outreach - E: Bounce Handler (Brevo Webhook)",
  "description": "Receives webhook events from Brevo for bounces, complaints, and unsubscribes. Updates Google Sheet to mark contacts as do_not_contact.",
  "scheduling": {
    "type": "webhook",
    "note": "Triggered by Brevo webhook events"
  },
  "flow": [
    {
      "id": 1,
      "module": "webhooks:customWebhook",
      "name": "Receive Brevo Webhook",
      "parameters": {
        "name": "brevo_email_events",
        "method": "POST",
        "dataStructure": {
          "event": "string",
          "email": "string",
          "date": "string",
          "message-id": "string",
          "reason": "string",
          "tag": "string",
          "ts_event": "number"
        }
      },
      "metadata": {
        "notes": "Webhook URL will be generated by Make.com - configure in Brevo settings"
      }
    },
    {
      "id": 2,
      "module": "flow:router",
      "name": "Route by Event Type",
      "parameters": {
        "routes": [
          {
            "condition": "{{1.event == 'hard_bounce'}}",
            "label": "Hard Bounce"
          },
          {
            "condition": "{{1.event == 'soft_bounce'}}",
            "label": "Soft Bounce"
          },
          {
            "condition": "{{1.event == 'spam'}}",
            "label": "Spam Complaint"
          },
          {
            "condition": "{{1.event == 'unsubscribed'}}",
            "label": "Unsubscribed"
          },
          {
            "condition": "{{1.event == 'blocked'}}",
            "label": "Blocked"
          },
          {
            "condition": "{{1.event == 'invalid_email'}}",
            "label": "Invalid Email"
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "google-sheets:searchRows",
      "name": "Find Contact by Email",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "tableContainsHeaders": true,
        "filter": {
          "conditions": [
            {
              "column": "email",
              "operator": "textEquals",
              "value": "{{1.email}}"
            }
          ]
        },
        "limit": 1
      },
      "routes": ["Hard Bounce", "Soft Bounce", "Spam Complaint", "Unsubscribed", "Blocked", "Invalid Email"]
    },
    {
      "id": 4,
      "module": "flow:router",
      "name": "Check if Contact Found",
      "parameters": {
        "routes": [
          {
            "condition": "{{length(3.bundles) > 0}}",
            "label": "Contact Found"
          },
          {
            "condition": "{{length(3.bundles) == 0}}",
            "label": "Contact Not Found"
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "name": "Mark as Do Not Contact (Hard Bounce)",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "bounced",
          "do_not_contact": "TRUE",
          "notes": "Hard bounce: {{1.reason}} ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Hard Bounce",
      "route": "Contact Found"
    },
    {
      "id": 6,
      "module": "google-sheets:updateRow",
      "name": "Mark Soft Bounce (Retry Later)",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "soft_bounce",
          "notes": "{{3.bundles[0].notes}}; Soft bounce: {{1.reason}} ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Soft Bounce",
      "route": "Contact Found",
      "metadata": {
        "notes": "Soft bounces can be retried - don't mark as do_not_contact"
      }
    },
    {
      "id": 7,
      "module": "google-sheets:updateRow",
      "name": "Mark as Do Not Contact (Spam)",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "spam_complaint",
          "do_not_contact": "TRUE",
          "notes": "SPAM COMPLAINT - DO NOT CONTACT ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Spam Complaint",
      "route": "Contact Found",
      "metadata": {
        "notes": "CRITICAL: Spam complaints must NEVER be contacted again"
      }
    },
    {
      "id": 8,
      "module": "google-sheets:updateRow",
      "name": "Mark as Unsubscribed",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "unsubscribed",
          "unsubscribe": "TRUE",
          "notes": "Unsubscribed ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Unsubscribed",
      "route": "Contact Found"
    },
    {
      "id": 9,
      "module": "google-sheets:updateRow",
      "name": "Mark as Blocked",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "blocked",
          "do_not_contact": "TRUE",
          "notes": "Blocked by recipient: {{1.reason}} ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Blocked",
      "route": "Contact Found"
    },
    {
      "id": 10,
      "module": "google-sheets:updateRow",
      "name": "Mark as Invalid Email",
      "parameters": {
        "spreadsheetId": "{{YOUR_SPREADSHEET_ID}}",
        "sheetId": "Galleries",
        "rowNumber": "{{3.bundles[0].row_number}}",
        "values": {
          "status": "invalid_email",
          "do_not_contact": "TRUE",
          "notes": "Invalid email address ({{formatDate(now; 'YYYY-MM-DD')}})"
        }
      },
      "parentRoute": "Invalid Email",
      "route": "Contact Found"
    },
    {
      "id": 11,
      "module": "tools:setVariable",
      "name": "Log Event",
      "parameters": {
        "name": "event_log",
        "value": "Processed {{1.event}} for {{1.email}} at {{formatDate(now; 'YYYY-MM-DD HH:mm:ss')}}"
      }
    }
  ],
  "variables": {
    "YOUR_SPREADSHEET_ID": {
      "type": "text",
      "description": "Your Google Sheets spreadsheet ID"
    }
  },
  "connections": {
    "google-sheets": {
      "type": "oauth2",
      "service": "google",
      "scopes": ["spreadsheets"]
    }
  },
  "setup_instructions": [
    "1. Import this blueprint into Make.com",
    "2. Connect your Google account for Sheets access",
    "3. Replace {{YOUR_SPREADSHEET_ID}} with your spreadsheet ID",
    "4. Save the scenario to get the webhook URL",
    "5. Configure Brevo webhook:",
    "   a. Go to Brevo > Settings > Webhooks",
    "   b. Click 'Add a new webhook'",
    "   c. Paste the Make.com webhook URL",
    "   d. Select events: hard_bounce, soft_bounce, spam, unsubscribed, blocked, invalid_email",
    "   e. Save the webhook",
    "6. Enable the scenario in Make.com"
  ],
  "brevo_events_explained": {
    "hard_bounce": "Permanent delivery failure - email address doesn't exist",
    "soft_bounce": "Temporary delivery failure - mailbox full, server issues (can retry)",
    "spam": "Recipient marked email as spam - CRITICAL: never contact again",
    "unsubscribed": "Recipient clicked unsubscribe link",
    "blocked": "Email blocked by recipient's server",
    "invalid_email": "Email address format is invalid"
  }
}
